<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="userSerachScene" prefHeight="670.0" prefWidth="934.0" spacing="12" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.tvz.sportapp.controller.UserSearchController">

<padding>
    <Insets bottom="15" left="15" right="15" top="15" />
</padding>

<Label style="-fx-font-size: 22px;" text="Pretraživanje osoba" />

<HBox spacing="10">
      <ComboBox fx:id="choiceComboBox" prefHeight="26.0" prefWidth="68.0" promptText="Ime" />
    <TextField fx:id="txtFld" promptText="npr. Bruno" />

    <RadioButton fx:id="userRadio" prefHeight="34.0" prefWidth="49.0" text="User" />
    <RadioButton fx:id="coachRadio" prefHeight="28.0" prefWidth="59.0" text="Coach" />

    <Button onAction="#searchClick" prefHeight="0.0" prefWidth="59.0" text="Pretraži" />
</HBox>

<TableView fx:id="table" prefHeight="489.0" prefWidth="904.0">
    <columns>
        <TableColumn fx:id="oibCol" prefWidth="140" text="OIB" />
        <TableColumn fx:id="firstNameCol" prefWidth="160" text="Ime" />
        <TableColumn fx:id="lastNameCol" prefWidth="160" text="Prezime" />
        <TableColumn fx:id="extraCol" prefWidth="220" text="Dodatno" />
    </columns>
</TableView>
   <Button alignment="CENTER" contentDisplay="TOP" onAction="#inputUser" prefHeight="26.0" prefWidth="105.0" text="Unos korisnika" />

</VBox>
