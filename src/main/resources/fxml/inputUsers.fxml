      <RowConstraints minHeight="10.0" prefHeight="30.0" />
      <RowConstraints minHeight="10.0" prefHeight="30.0" />
      <RowConstraints minHeight="10.0" prefHeight="30.0" />
      <RowConstraints />
    </rowConstraints>

    <!-- NASLOV -->
    <Label prefHeight="70.0" prefWidth="410.0" text="Unos osobe i trenera" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER">
        <font>
            <Font name="Impact" size="40.0" />
        </font>
        <GridPane.margin>
            <Insets />
        </GridPane.margin>
      <padding>
         <Insets bottom="10.0" top="10.0" />
      </padding>
    </Label>

    <!-- ZAJEDNIČKA POLJA -->
    <Label text="OIB*:" GridPane.rowIndex="3">
        <font><Font name="Courier New" size="18.0" /></font>
        <GridPane.margin><Insets left="20.0" /></GridPane.margin>
    </Label>
    <TextField fx:id="oibField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

    <Label text="Ime*:" GridPane.rowIndex="4">
        <font><Font name="Courier New" size="18.0" /></font>
        <GridPane.margin><Insets left="20.0" /></GridPane.margin>
    </Label>
    <TextField fx:id="firstNameField" GridPane.columnIndex="1" GridPane.rowIndex="4" />

    <Label text="Prezime*:" GridPane.rowIndex="5">
        <font><Font name="Courier New" size="18.0" /></font>
        <GridPane.margin><Insets left="20.0" /></GridPane.margin>
    </Label>
    <TextField fx:id="lastNameField" GridPane.columnIndex="1" GridPane.rowIndex="5" />

