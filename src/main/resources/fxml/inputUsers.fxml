    <Label fx:id="specializationLabel" text="Specijalizacija:" GridPane.columnIndex="2" GridPane.rowIndex="9">
        <font><Font name="Courier New" size="18.0" /></font>
        <GridPane.margin><Insets left="20.0" /></GridPane.margin>
    </Label>
    <TextField fx:id="specializationField" prefHeight="26.0" prefWidth="190.0" GridPane.columnIndex="3" GridPane.rowIndex="9">
      <GridPane.margin>
         <Insets right="30.0" />
      </GridPane.margin></TextField>

    <Label fx:id="usernameLabel" text="Username:" GridPane.columnIndex="2" GridPane.rowIndex="3">
        <font><Font name="Courier New" size="18.0" /></font>
        <GridPane.margin><Insets left="20.0" /></GridPane.margin>
    </Label>
    <TextField fx:id="usernameField" GridPane.columnIndex="3" GridPane.rowIndex="3">
      <GridPane.margin>
         <Insets right="30.0" />
      </GridPane.margin></TextField>

    <Label fx:id="passwordLabel" text="Password:" GridPane.columnIndex="2" GridPane.rowIndex="4">
        <font><Font name="Courier New" size="18.0" /></font>
        <GridPane.margin><Insets left="20.0" /></GridPane.margin>
    </Label>
    <TextField fx:id="passwordField" GridPane.columnIndex="3" GridPane.rowIndex="4">
      <GridPane.margin>
         <Insets right="30.0" />
      </GridPane.margin></TextField>

    <Button onAction="#onSave" prefHeight="26.0" prefWidth="94.0" text="Spremi" GridPane.halignment="RIGHT" GridPane.rowIndex="17">
