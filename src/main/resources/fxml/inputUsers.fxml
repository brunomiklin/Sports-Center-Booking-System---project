            <Insets bottom="10.0" right="40.0" top="10.0" />
        </GridPane.margin>
      <font>
         <Font name="Impact" size="13.0" />
      </font>
    </Button>
 <Button mnemonicParsing="false" onAction="#searchUser" prefHeight="26.0" prefWidth="115.0" text="Pretraži" textAlignment="JUSTIFY" GridPane.columnSpan="2" GridPane.rowIndex="17">
