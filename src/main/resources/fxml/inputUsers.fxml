        <GridPane.margin><Insets left="20.0" /></GridPane.margin>
    </Label>

    <GridPane GridPane.columnIndex="1" GridPane.rowIndex="6">
        <columnConstraints>
            <ColumnConstraints prefWidth="120.0" />
            <ColumnConstraints prefWidth="120.0" />
        </columnConstraints>

        <children>
            <RadioButton fx:id="userRadio" text="User" GridPane.rowIndex="2">
                <toggleGroup>
                    <ToggleGroup fx:id="personTypeGroup" />
                </toggleGroup>
            <GridPane.margin>
               <Insets left="20.0" />
            </GridPane.margin>
            </RadioButton>

            <RadioButton fx:id="coachRadio" text="Coach" toggleGroup="$personTypeGroup" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        </children>
      <rowConstraints>
