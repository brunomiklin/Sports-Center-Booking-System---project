         <Insets />
      </opaqueInsets>
      <GridPane.margin>
         <Insets left="150.0" />
      </GridPane.margin>
      <font>
         <Font name="Impact" size="13.0" />
      </font>
   </Button>
   <Button mnemonicParsing="false" onAction="#takeMeHome" text="合" GridPane.halignment="CENTER" GridPane.rowIndex="1">
      <GridPane.margin>
         <Insets right="20.0" />
      </GridPane.margin>
      <font>
         <Font name="Impact" size="16.0" />
      </font>
      <effect>
         <Glow level="0.37" />
      </effect>
   </Button>

</GridPane>
